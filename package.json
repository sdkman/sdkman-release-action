{
  "name": "sdkman-release-action",
  "version": "0.1.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "package": "npx ncc build src/index.js -o dist --source-map --license licenses.md",
    "package:watch": "npm run package -- --watch",
    "test": "jest"
  },
  "keywords": [],
  "author": "Hamza Remmal <hamza@remmal.net> (https://remmal.net)",
  "license": "ISC",
  "private": true,
  "homepage": "https://github.com/hamzaremmal/sdkman-release-action",
  "bugs": {
    "url": "https://github.com/hamzaremmal/sdkman-release-action/issues/new"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.5.2",
    "nock": "^14.0.17"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ]
  }
}
